{% extends 'main_card.html.twig' %}
{% block title %}{{ sheet.id ? 'label_sheet.edit'|trans : 'label_sheet.new'|trans }}{% endblock %}
{% block card_title %}<i class="fas fa-tags fa-fw"></i> {% trans %}label_sheet.labelp{% endtrans %}{% endblock %}
{% block card_content %}
    <div class="row">
        <div class="col-sm-4">
            <div class="list-group mb-3">
                <a class="list-group-item list-group-item-action {{ sheet.id is null ? 'active' }}" href="{{ path('label_sheet_new') }}"><i class="fas fa-plus fa-fw"></i> {% trans %}label_sheet.new{% endtrans %}</a>
                {% for existing_sheet in sheets %}
                    <a class="list-group-item list-group-item-action {{ sheet.id == existing_sheet.id ? 'active' }}" href="{{ path('label_sheet_edit', {id: existing_sheet.id}) }}"><i class="fas fa-tags fa-fw"></i> {{ existing_sheet.name }}</a>
                {% endfor %}
            </div>
        </div>
        <div class="col-sm-8">
            <fieldset>
                <legend><strong>{{ sheet.id ? 'label_sheet.edit'|trans ~ ': ' ~ sheet.name : 'label_sheet.new'|trans }}</strong></legend>
                {{ form_errors(form) }}
                <ul class="nav nav-tabs mt-2"><li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#label-sheet-standard">{% trans %}standard.label{% endtrans %}</a></li></ul>
                <div class="tab-content mb-3 mt-3"><div class="tab-pane fade show active" id="label-sheet-standard" {{ stimulus_controller('pages/label_sheet') }}>
                    {{ form_start(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.page_size) }}
                    {{ form_row(form.unit) }}
                    <div class="mb-2 row"><label class="{{ col_label }} col-form-label">{% trans %}label_options.sheet_size.label{% endtrans %}</label><div class="{{ col_input }}">
                        <div class="input-group">{{ form_widget(form.width) }}<span class="input-group-text">x</span>{{ form_widget(form.height) }}<span class="input-group-text" {{ stimulus_target('pages/label_sheet', 'unitSuffix') }}></span></div>
                        {{ form_errors(form.width) }}{{ form_errors(form.height) }}
                    </div></div>
                    <div class="mb-2 row"><label class="{{ col_label }} col-form-label">{% trans %}label_options.page_size.label{% endtrans %}</label><div class="{{ col_input }}">
                        <div class="input-group">{{ form_widget(form.label_width) }}<span class="input-group-text">x</span>{{ form_widget(form.label_height) }}<span class="input-group-text" {{ stimulus_target('pages/label_sheet', 'unitSuffix') }}></span></div>
                        {{ form_errors(form.label_width) }}{{ form_errors(form.label_height) }}
                    </div></div>
                    <div class="mb-2 row"><label class="{{ col_label }} col-form-label">{% trans %}label_options.grid_size.label{% endtrans %}</label><div class="{{ col_input }}">
                        <div class="input-group">{{ form_widget(form.columns) }}<span class="input-group-text">x</span>{{ form_widget(form.rows) }}</div>
                        {{ form_errors(form.columns) }}{{ form_errors(form.rows) }}
                    </div></div>
                    {{ form_row(form.margin_left) }}
                    {{ form_row(form.margin_top) }}
                    {{ form_row(form.gutter_width) }}
                    {{ form_row(form.gutter_height) }}
                    {{ form_row(form.corner_radius) }}
                    <div class="form-group row"><div class="{{ col_input }} {{ offset_label }}">{{ form_widget(form.save) }}</div></div>
                    {{ form_row(form.reset) }}
                    {{ form_end(form) }}
                    {% if sheet.id %}
                        <form method="post" action="{{ path('label_sheet_delete', {id: sheet.id}) }}" class="mt-3" onsubmit="return confirm('{{ 'delete.confirm'|trans|e('js') }}')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-label-sheet-' ~ sheet.id) }}">
                            <button class="btn btn-danger"><i class="fas fa-trash fa-fw"></i> {% trans %}entity.delete{% endtrans %}</button>
                        </form>
                    {% endif %}
                </div></div>
            </fieldset>
        </div>
    </div>
{% endblock %}
